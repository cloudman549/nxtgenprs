{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "300mb",
        "maxDuration": 60,
        "includeFiles": [
          "static/**",
          "templates/**",
          "data/**"
        ],
        "excludeFiles": [
          "venv/**",
          "**/__pycache__/**",
          ".git/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}