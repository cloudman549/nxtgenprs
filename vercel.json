{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "300mb",
        "includeFiles": [
          "static/**",
          "templates/**",
          "data/**"
        ],
        "excludeFiles": [
          "venv/**",
          "**/__pycache__/**",
          ".git/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}